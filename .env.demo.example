# ---------------------------------------------------------------------------
# LebaSouk — DEMO build environment
#
# Copy to .env before building a demo:   cp .env.demo.example .env
# Everything here differs from .env.example on purpose. See docs/demo-build.md.
#
# This file carries no secrets and is committed. Generate APP_KEY on the build
# machine with `php artisan key:generate` — never paste a key in here.
# ---------------------------------------------------------------------------

# A demo build and a production install must not share a name, an app id, or a
# data directory. Electron derives %APPDATA%\<APP_NAME>\ from APP_NAME, so this
# is also what keeps the two installs' databases apart — and what puts the word
# "demo" in the database path that App\Support\Demo::guardDatabasePath() checks.
APP_NAME="LebaSouk Demo"
NATIVEPHP_APP_ID=com.buildsyntax.lebasouk.demo

APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The switch. Restores database/demo-template.sqlite over the runtime database
# on every launch, blocks backups/exports/identity settings, and puts the demo
# banner on every screen.
POS_DEMO_MODE=true

# Shared password for demo_admin / demo_manager / demo_cashier / demo_stock.
# Shown on the login screen of a demo build, so it is not a secret — but change
# it here (and rebuild the template) if you want a different one.
POS_DEMO_PASSWORD=demo1234

# Running locally (php artisan serve) rather than packaged? The guard requires
# "demo" in the database path, so point the connection at a demo file:
# DB_DATABASE=database/demo.sqlite
DB_CONNECTION=sqlite

# Nothing may leave a demo machine.
# The auto-updater polls a release channel on startup — off for demo builds.
NATIVEPHP_UPDATER_ENABLED=false
MAIL_MAILER=log
BROADCAST_CONNECTION=log

SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

BCRYPT_ROUNDS=12

VITE_APP_NAME="${APP_NAME}"
