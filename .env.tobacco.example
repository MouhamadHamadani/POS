# ---------------------------------------------------------------------------
# LebaSouk — TOBACCO client build (branch client/tobacco)
#
# Only what differs from .env.example. Copy .env.example to .env first, then
# REPLACE these lines in it (do not append: a repeated key is not reliably
# won by the later line). See docs/packaging.md.
#
# No secrets in this file: it is committed. APP_KEY, the super_admin hash and
# the updater credentials stay in the build machine's own .env.
# ---------------------------------------------------------------------------

# The switch. On: the product form gets a Packaging section, the till asks
# "Pack or Package?" for a packaged product, cartons can be received and (per
# product) sold, stock can be received by the package or the carton.
# Off: this branch behaves exactly like main.
POS_PACKAGING=true

# A different install from every other LebaSouk client: Electron derives the
# data directory (%APPDATA%\<APP_NAME>\) from APP_NAME, so these two also keep
# this client's database apart from a plain LebaSouk install on the same PC.
APP_NAME="LebaSouk Tobacco"
NATIVEPHP_APP_ID=com.buildsyntax.lebasouk.tobacco
