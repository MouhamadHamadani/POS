# ---------------------------------------------------------------------------
# LebaSouk — VORTEX ENERGY client build environment
#
# Copy to .env before building:   cp .env.vortex.example .env
# Same codebase and same production settings as .env.example; only the lines
# marked CLIENT differ. See CLAUDE.md, "Client builds".
#
# This file carries no secrets and is committed. Generate APP_KEY on the build
# machine with `php artisan key:generate` — never paste a key in here.
# ---------------------------------------------------------------------------

# CLIENT — selects config/clients/vortex.php and resources/clients/vortex/.
# native:build refuses to package if this names a profile that doesn't exist.
POS_CLIENT=vortex
POS_BUSINESS_NAME="Vortex Energy"

# CLIENT — a client build must not share a name, an app id, or a data directory
# with LebaSouk. Electron derives %APPDATA%\<APP_NAME>\ from APP_NAME, so this is
# also what keeps the two installs' databases apart on a machine that has both.
APP_NAME="Vortex Energy POS"
NATIVEPHP_APP_ID=com.buildsyntax.lebasouk.vortex

APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Beirut
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DAILY_DAYS=14
LOG_LEVEL=info

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Desktop packaging (NativePHP). Bump NATIVEPHP_APP_VERSION before every
# release build -- NativePHP uses the version change to decide when to run
# migrations against the installed database.
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_AUTHOR=BuildSyntax
NATIVEPHP_APP_COPYRIGHT="(c) 2026 Build Syntax"

# Same as main: no updater provider has credentials, so the installed app does
# not update itself — a new version means a new installer (INSTALL_NOTES.md §6).
NATIVEPHP_UPDATER_ENABLED=false

# Nothing in this app is scheduled; see .env.example and INSTALL_NOTES.md §10.
NATIVEPHP_SCHEDULER_ENABLED=false

# Never a demo: a demo ships known credentials and resets its database on launch.
POS_DEMO_MODE=false
